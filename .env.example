# Browser-visible configuration only.
# Never put secret API keys in VITE_* variables. Set those in the Convex dashboard.

# Convex deployment URL (npx convex dev prints this)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Convex HTTP actions (AssemblyAI token, Stripe webhook, AgentMail)
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site

# Site URL for generating interview links
VITE_SITE_URL=https://truevoicehq.com

# LiveKit websocket URL. The API key and secret stay in Convex:
# LIVEKIT_URL, LIVEKIT_API_KEY, LIVEKIT_API_SECRET
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Stripe price IDs are public. The secret key and webhook secret stay in Convex.
VITE_STRIPE_PRICE_STARTER_MONTHLY=price_...
VITE_STRIPE_PRICE_STARTER_YEARLY=price_...
VITE_STRIPE_PRICE_PRO_MONTHLY=price_...
VITE_STRIPE_PRICE_PRO_YEARLY=price_...
VITE_STRIPE_PRICE_SCALE_MONTHLY=price_...
VITE_STRIPE_PRICE_SCALE_YEARLY=price_...

# Convex dashboard environment variables (server-side):
# - ASSEMBLYAI_API_KEY
# - DEEPGRAM_API_KEY
# - XAI_API_KEY (or AI_PROXY_KEY + AI_PROXY_URL)
# - LIVEKIT_API_KEY, LIVEKIT_API_SECRET, LIVEKIT_URL
# - STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_PRICE_*
# - EMAIL_PROVIDER and the matching provider token
# - AGENTMAIL_API_KEY, AGENTMAIL_WEBHOOK_SECRET
# - JWT_PRIVATE_KEY and JWKS for Convex Auth (generate locally; do not commit)
