# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL for generating interview links
# Defaults to current domain if not set
# Production: https://your-production-domain.com
# Development: http://localhost:8080
VITE_SITE_URL=https://truevoicehq.com

# LiveKit (Video conferencing) - Frontend needs URL only
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Stripe (Billing & Subscriptions) - Client keys only
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Stripe Price IDs (generated by scripts/stripe-setup.ts)
VITE_STRIPE_PRICE_STARTER_MONTHLY=price_...
VITE_STRIPE_PRICE_STARTER_YEARLY=price_...
VITE_STRIPE_PRICE_PRO_MONTHLY=price_...
VITE_STRIPE_PRICE_PRO_YEARLY=price_...
VITE_STRIPE_PRICE_SCALE_MONTHLY=price_...
VITE_STRIPE_PRICE_SCALE_YEARLY=price_...

# ⚠️ SECURITY NOTE ⚠️
# NEVER put API keys with write access in client-side env vars (VITE_*)
# Deepgram, LiveKit API keys, and Stripe secret keys belong in Supabase secrets
# See SECURITY-FIXES-2026-08-13.md for details

# Backend-only secrets (set in Supabase dashboard → Settings → Edge Functions):
# - DEEPGRAM_API_KEY (for deepgram-token function)
# - LIVEKIT_API_KEY (for livekit-token function)
# - LIVEKIT_API_SECRET (for livekit-token function)
# - XAI_API_KEY (for analyze-chunk function)
# - STRIPE_SECRET_KEY (for stripe-webhook function)
# - STRIPE_WEBHOOK_SECRET (for stripe-webhook function)
